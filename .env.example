# ============================================================
# RASITO — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in the values.
# These are only needed when integrating with Supabase.
# The demo works without any environment variables.
# ============================================================

# Supabase (needed only for backend integration)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Never expose service-role keys in frontend code.
# Service-role keys should only be used in server-side code.
